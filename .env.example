# ============================================================
#  统一知识库与智能问数平台 — 配置模板
#  用法：复制为 .env 后填写真实值（.env 不入库）
# ============================================================

# ─── 应用 ────────────────────────────────────────────────
APP_NAME=统一知识库与智能问数平台
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ─── PostgreSQL（内容库：文档/切片/向量/对话/词典，本地 docker）───
DATABASE_URL=postgresql+psycopg://kb:kb_dev_pwd@127.0.0.1:5433/ad_new
DB_ECHO=false


# ─── MySQL（员工表 / 业务库 / 字典库）─────────────────────
# 统一用户表权威源：dlj_data.t_employee
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
# 三个库名（一般不用改）
MYSQL_DB_BUSINESS=dlj_data      # 业务数据（只读）
MYSQL_DB_DICT=ai_data           # 业务字典与系统提示词（只读）
MYSQL_DB_AGENT=agent_data       # agent 对话记录与纠错词典（读写）

# ─── 安全 ────────────────────────────────────────────────
# ⚠️ JWT_SECRET 必须自己生成，不要留空、也不要用这里的默认值：
#     openssl rand -hex 32
# 留空或沿用默认值 ⇒ 任何人都能用公开的密钥伪造登录 token。
# 部署前跑 scripts/preflight_check.py，它是 FAIL 就说明还没改。
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ══════════════════════════════════════════════════════════
#  ⭐ 模型通道总开关：mock | local | online
#    mock   = 零依赖演示（伪向量，不可评估检索质量）
#    local  = 公司内网自建模型（vLLM / Xinference / Ollama）
#    online = 线上 API（阿里云百炼 compatible-mode）
#  ⚠️ 切换 embedding 通道后，向量空间不兼容，必须重建索引！
# ══════════════════════════════════════════════════════════
MODEL_CHANNEL=local
EMBEDDING_DIM=1024

# ─── 本地通道（内网自建，OpenAI 兼容端点）────────────────
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=deepseek-chat
LOCAL_LLM_API_KEY=
# 内网「可选模型」清单（逗号分隔）。留空 = 只有上面 LOCAL_LLM_MODEL 一个。
# ⚠️ 内网模型服务上**实际部署了哪些就写哪些** —— 问数页的模型下拉框只显示这里列出的。
#    例：LOCAL_MODELS=deepseek-chat,Qwen3-32B
LOCAL_MODELS=
LOCAL_EMBEDDING_URL=http://127.0.0.1:9997/v1/embeddings
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_EMBEDDING_API_KEY=
LOCAL_RERANK_URL=http://127.0.0.1:9997/v1/rerank
LOCAL_RERANK_MODEL=bge-rerank-m3
LOCAL_RERANK_API_KEY=

# ─── 线上通道（阿里云百炼 compatible-mode）────────────────
ONLINE_LLM_BASE_URL=https://llm-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ONLINE_LLM_API_KEY=
# 主模型：知识库问答 + 问数 agent（需工具调用与长回答最稳）
# 默认 deepseek-v4.1-flash-1017（实测简单题 6.7s、复杂题 25.7s）；
# 要更快可换 qwen3.8-max（复杂题 13.5s，但回答略简），要更便宜可试 qwen3.8-flash。
# ⚠️ qwen3.6-flash 在部分网关返回 400（2026-10-19 实测），切换前先提问验证。
ONLINE_LLM_MODEL=deepseek-v4.1-flash-1017
# 冲突判定**专用**模型（留空 = 跟随 ONLINE_LLM_MODEL）。
# ⚠️ 判定只是四分类关系判断，用快模型即可：实测 qwen-plus 比 qwen3.8-max 快约 4 倍。
#    qwen-turbo / qwen3.8-plus 需该网关已部署，否则 404。
ONLINE_JUDGE_MODEL=qwen-plus
ONLINE_EMBEDDING_BASE_URL=https://llm-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ONLINE_EMBEDDING_API_KEY=
ONLINE_EMBEDDING_MODEL=text-embedding-v4
ONLINE_RERANK_BASE_URL=https://llm-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ONLINE_RERANK_API_KEY=
ONLINE_RERANK_MODEL=gte-rerank-v2


# ─── 文件存储 ────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=100

# ─── 冲突检测 ────────────────────────────────────────────
AUTO_CONFLICT_CHECK=true
CONFLICT_MAX_LLM_CALLS=12

# ─── 性能调优（2026-10-15 新增）────────────────────────────
# 向量化分批并发度：online 档单请求**硬限 10 条**（超过直接 400），
# 长文档只能靠并发提速。设 1 = 退回串行（内网 embedding 服务不支持并发时用）。
# ⚠️ 太高易触发在线 429；8 是提速与限流的平衡点。
EMBED_BATCH_CONCURRENCY=8
# 冲突判定（LLM）与候选精排（rerank）的并发度。两者各自独立、互不依赖，可并发。
CONFLICT_JUDGE_CONCURRENCY=8
CONFLICT_RERANK_CONCURRENCY=8
# 单次冲突检测中「精排候选组数」上限：精排是每组一次请求，病态输入（整篇雷同
# 文档）会产生上千组，此上限防止打爆外部 rerank 服务。超出时按相似度取前 N 组。
CONFLICT_RERANK_MAX_GROUPS=200

# ─── CORS ────────────────────────────────────────────────
# 开发期前端 dev server（5173）；生产前端由后端 8200 托管，同源无需跨域。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8200,http://127.0.0.1:8200

# ══════════════════════════════════════════════════════════
#  问数 agent（已并入同一后端进程，随服务 :8200 一起启动）
# ══════════════════════════════════════════════════════════
SECRETARY_HOST=127.0.0.1
SECRETARY_PORT=8200
# ─── 默认检索范围（优先级从高到低）─────────────────────────
#   ① 问答页勾选的 kb_ids（服务端校验后生效）
#   ② 库里 qa_enabled=1（「参与智能问答」标记）的 active 库
#   ③ SECRETARY_DEFAULT_KB_ID（显式钉死，建库后 id 稳定时最稳）
#   ④ 切片数最多的 active 库（动态兜底）
# ⚠️ 自增 id 会因删库/重建漂移：写死在这里、库又重建过 ⇒ 检索静默返回 0 条
#    （本项目踩过：写死 1,2，而真正有内容的库是 3）。所以优先用 ②/③，别只靠 ④。
# 留空 = 自动（走 ②③④）
SECRETARY_KB_IDS=
# 显式钉死默认知识库 id（可选，单个数字）。留空 = 自动选切片最多的库
SECRETARY_DEFAULT_KB_ID=
# agent 调知识库的地址（合并后为进程内直调，此项仅兼容保留）
SECRETARY_KB_BASE=http://127.0.0.1:8200/api/v1

# ══════════════════════════════════════════════════════════
#  合并项目补充（2026-10-19）
# ══════════════════════════════════════════════════════════
# 每日预警接口（POST /api/alerts/daily）的鉴权：调用方是**外部定时任务**，
# 拿不到用户 JWT，所以用这个内部令牌放行（请求头 X-Internal-Token）。
# 留空 = 不校验（只适合本机开发；线上必须配）。
INTERNAL_SERVICE_TOKEN=
# 页面生成（分析题额外渲染一屏 HTML）：2026-10-19 起**默认关闭且代码已注释**，
# 需要恢复时才在 agent.py 里放开 render_page/render_page_async 并设 SECRETARY_PAGE=1。
SECRETARY_PAGE=0
