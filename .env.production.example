# ══════════════════════════════════════════════════════════════
#  生产环境变量模板
#  用法：cp .env.production.example .env.production  然后按需修改
#
#  ⚠️ DATABASE_URL / REDIS_URL / UPLOAD_DIR 不在此文件写死 ——
#     由 docker-compose.prod.yml 的 environment 注入（容器内用服务名互访）。
#     本文件只放“应用层”配置。
# ══════════════════════════════════════════════════════════════

# ─── 应用 ────────────────────────────────────────────────────
APP_NAME=企业级本地知识库系统
APP_ENV=production
DEBUG=false

# ─── 安全（⚠️ 必须替换：openssl rand -hex 32）─────────────────
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ══════════════════════════════════════════════════════════════
#  ⭐ 模型档位开关
#     mock   : 零依赖，确定性假向量（仅演示，检索无真实语义）
#     online : 线上 API（阿里云百炼 + DeepSeek）——公网服务器可用
#     local  : 公司内网自建模型 ——内网部署时用
# ══════════════════════════════════════════════════════════════
PROVIDER_MODE=online
EMBEDDING_DIM=1024

# ─── online 档：阿里云百炼（Embedding + Rerank）───────────────
# ⚠️ DeepSeek 官方无 embedding 服务，embedding 只能走阿里云
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_EMBEDDING_MODEL=text-embedding-v4
ALIYUN_RERANK_MODEL=gte-rerank-v2
ALIYUN_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
ALIYUN_LLM_MODEL=qwen-plus

# ─── online 档：DeepSeek（LLM）───────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ─── local 档：公司内网模型（内网部署时填，公网可留空）────────
LOCAL_EMBEDDING_URL=http://127.0.0.1:9997/v1/embeddings
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_RERANK_URL=http://127.0.0.1:9997/v1/rerank
LOCAL_RERANK_MODEL=bge-rerank-m3
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=deepseek-chat
LOCAL_LLM_API_KEY=

# ─── 文件存储 ────────────────────────────────────────────────
MAX_UPLOAD_MB=100

# ─── 限流（默认值，可按 API 应用覆盖）────────────────────────
DEFAULT_QPS_LIMIT=5
DEFAULT_DAILY_QUOTA=10000

# ─── CORS（⚠️ 填独立前端项目的实际域名；同域反代可留默认）─────
CORS_ORIGINS=https://kb.example.com

# ─── 冲突检测 ────────────────────────────────────────────────
AUTO_CONFLICT_CHECK=true
CONFLICT_MAX_LLM_CALLS=12

# ─── 初始管理员（⚠️ 首次登录后立即改密）───────────────────────
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password
