# ══════════════════════════════════════════════════════════════
#  生产环境变量模板
#  用法：cp .env.production.example .env.production  然后按需修改
#
#  ⚠️ DATABASE_URL / UPLOAD_DIR 不在此文件写死 ——
#     由 docker-compose.prod.yml 的 environment 注入（容器内用服务名互访）。
#     本文件只放“应用层”配置。
# ══════════════════════════════════════════════════════════════

# ─── 应用 ────────────────────────────────────────────────────
APP_NAME=统一知识库与智能问数平台
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# ─── 安全（⚠️ 必须替换：openssl rand -hex 32）─────────────────
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ─── MySQL 统一用户表（t_employee 认证源，只读）───────────────
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB_BUSINESS=dlj_data
MYSQL_DB_DICT=ai_data
MYSQL_DB_AGENT=agent_data

# ══════════════════════════════════════════════════════════════
#  ⭐ 模型档位开关：mock | local | online
#     online : 线上 API（阿里云百炼 compatible-mode）——公网服务器可用
#     local  : 公司内网自建模型 —— 内网部署时用
#  ⚠️ 切换 embedding 档后向量空间不兼容，必须重建索引！
# ══════════════════════════════════════════════════════════════
MODEL_CHANNEL=online
EMBEDDING_DIM=1024

# ─── 线上档：阿里云百炼 compatible-mode ──────────────────────
ONLINE_LLM_BASE_URL=
ONLINE_LLM_API_KEY=
ONLINE_LLM_MODEL=qwen3.8-max
# 冲突判定专用（留空 = 跟随 ONLINE_LLM_MODEL）；判定只需快模型
ONLINE_JUDGE_MODEL=qwen-plus
ONLINE_EMBEDDING_BASE_URL=
ONLINE_EMBEDDING_API_KEY=
ONLINE_EMBEDDING_MODEL=text-embedding-v4
ONLINE_RERANK_BASE_URL=
ONLINE_RERANK_API_KEY=
ONLINE_RERANK_MODEL=gte-rerank-v2

# ─── 本地档：公司内网模型（内网部署时填，公网可留空）────────
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=deepseek-chat
LOCAL_LLM_API_KEY=
# 内网「可选模型」清单（逗号分隔）。留空 = 只有上面 LOCAL_LLM_MODEL 一个。
# ⚠️ 内网模型服务上实际部署了哪些就写哪些 —— 问数页的模型下拉框只显示这里列出的。
LOCAL_MODELS=
LOCAL_EMBEDDING_URL=http://127.0.0.1:9997/v1/embeddings
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_EMBEDDING_API_KEY=
LOCAL_RERANK_URL=http://127.0.0.1:9997/v1/rerank
LOCAL_RERANK_MODEL=bge-rerank-m3
LOCAL_RERANK_API_KEY=

# ─── 文件存储 ────────────────────────────────────────────────
MAX_UPLOAD_MB=100

# ─── 冲突检测 ────────────────────────────────────────────────
AUTO_CONFLICT_CHECK=true
CONFLICT_MAX_LLM_CALLS=12

# ─── 性能调优 ────────────────────────────────────────────────
EMBED_BATCH_CONCURRENCY=8
CONFLICT_JUDGE_CONCURRENCY=8
CONFLICT_RERANK_CONCURRENCY=8
CONFLICT_RERANK_MAX_GROUPS=200

# ─── CORS（⚠️ 填独立前端项目的实际域名；同域反代可留默认）─────
CORS_ORIGINS=https://kb.example.com

# ─── 问数 agent（已并入同一后端进程，:8200）─────────────────
SECRETARY_HOST=0.0.0.0
SECRETARY_PORT=8200
# agent 默认检索的知识库 id（留空 = 用「参与问答」标记的库）
SECRETARY_KB_IDS=
SECRETARY_KB_BASE=http://127.0.0.1:8200/api/v1

# ─── 每日预警接口内部令牌（POST /api/alerts/daily）───────────
# 调用方是外部定时任务，拿不到用户 JWT，改用请求头 X-Internal-Token 放行。
# ⚠️ 生产必须填（建议 openssl rand -hex 32）；
#    留空 = 该接口完全不校验身份，任何能访问 8200 的人都能查任意账号的今日待办。
INTERNAL_SERVICE_TOKEN=

