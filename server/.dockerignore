# 构建上下文排除清单（server/ 目录）
# 目的：① 缩小构建上下文、加快构建；② 防止密钥/缓存被拷进镜像。

# ── Python 缓存与字节码 ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# ── 虚拟环境（服务器/容器内不复用本机 venv）────────────────────
.venv/
venv/
env/
ENV/

# ── 密钥与本地配置（⚠️ 绝不进镜像，运行时由 compose 注入）──────
.env
.env.*
!.env.example

# ── 工具缓存 ─────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── 日志与临时文件 ───────────────────────────────────────────
*.log
*.tmp
.DS_Store

# ── 测试与本地脚本（运行时不需要）────────────────────────────
tests/

# ── 探测/临时脚本目录（若存在）──────────────────────────────
scripts/_probe/
