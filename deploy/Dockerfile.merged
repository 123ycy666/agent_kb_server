# 合并版生产镜像（复用现有基础镜像的 Python 3.11 与依赖）
# 磁盘紧张：**禁止**把 FROM 改成 python:3.11-slim 之类，会触发拉取 1GB+ 镜像
FROM kb-backend:latest

WORKDIR /app

# 清掉旧项目代码，避免旧模块残留被误 import
RUN rm -rf /app/app /app/scripts /app/tests /app/requirements*.txt

# 新项目后端
COPY server/ /app/

# 前端构建产物：main.py 在 /app/app/main.py → parents[2] = / → 必须放到 /web/dist
COPY web/dist/ /web/dist/

# 站点包：site_pack.sites_root() = Path(server/app/secretary/site_pack.py).parents[3]/'config'/'sites'
# 在容器里 = /config/sites。不放进去 → jobs.yml / prompts / rules 全读不到，
# 包内定时任务空转（扫描就只能继续靠宿主机 crontab，2026-10-28 部署时发现）。
COPY config/ /config/

# 旧镜像缺这几个：pymysql（统一用户表 MySQL 只读）、argon2（HR 密码校验）、
# apscheduler（站点包 jobs.yml 的定时调度，2026-10-28 部署时发现缺失 → 定时任务空转）
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
        pymysql argon2-cffi apscheduler

EXPOSE 8200

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8200"]
